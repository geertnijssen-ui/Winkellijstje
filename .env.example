# Publiek (komt in de browser terecht)
PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJ...
PUBLIC_VAPID_PUBLIC_KEY=B...

# Geheim (alleen op de server / Netlify)
SUPABASE_SERVICE_ROLE_KEY=eyJ...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:jij@voorbeeld.be
# Willekeurige lange string; dezelfde waarde zet je in Supabase (zie docs/SETUP.md)
WEBHOOK_SECRET=verander-mij

# Update-knopje (Netlify > Site configuration > Build & deploy > Build hooks)
NETLIFY_BUILD_HOOK=https://api.netlify.com/build_hooks/xxxx
# Optioneel: tonen hoeveel nieuwe wijzigingen er op GitHub staan
GITHUB_REPO=geertnijssen-ui/winkellijstje
GITHUB_TOKEN=
GITHUB_BRANCH=main
