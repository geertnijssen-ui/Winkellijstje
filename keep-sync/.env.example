# Google-account waaraan je Google Home gekoppeld is
GOOGLE_EMAIL=jij@gmail.com
# Master token (zie docs/GOOGLE-HOME.md). Begint met "aas_et/". Behandel als wachtwoord!
GOOGLE_MASTER_TOKEN=aas_et/...
# Titel van de boodschappenlijst in Google Keep (zoals Google Home ze aanmaakt)
KEEP_LIST_TITLE=Boodschappenlijst

# Jullie app
APP_URL=https://jouw-site.netlify.app
# API-sleutel uit de app (Meer > Siri en Google Home > Maak sleutel)
APP_TOKEN=wl_...

# true = de lijst in Keep wordt herschreven, gesorteerd per winkel ("Colruyt: melk"),
# zodat "Hey Google, wat staat er op mijn boodschappenlijst?" alles per winkel voorleest.
WRITE_BACK=true
# Seconden tussen twee rondes in --loop modus
INTERVAL=60
